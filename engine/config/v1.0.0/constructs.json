{
  "constructs": [
    {
      "construct_id": "SK_COMMUNICATION",
      "display_name": "Communication & Expression",
      "definition": "Conveys information clearly and adjusts detail and tone to the audience.",
      "observable_indicators": [
        "States the essential point before the detail",
        "Adjusts register for the listener",
        "Checks understanding rather than assuming it"
      ],
      "derived_from": [
        {
          "signal_id": "SIG_COMMUNICATION_TRANSPARENCY",
          "weight": 1.0
        }
      ],
      "evidence": {
        "framework_basis": {
          "aqf_theme": "Communicates knowledge and ideas to a range of audiences",
          "acara_general_capability": "Literacy",
          "csfw_area": "Communicate for work",
          "asc_core_competency": "Speaking / Active Listening / Writing"
        },
        "mapping_strength": "strong",
        "item_support": 2,
        "validation_status": "framework-aligned",
        "empirical_validation": "none",
        "confidence": "medium",
        "known_limitations": [
          "Written expression is not directly observed; items infer it from choice behaviour"
        ]
      }
    },
