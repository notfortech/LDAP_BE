# Copy to .env and fill in. Production refuses to start if any required
# value is missing or unsafe -- see src/aptus_api/settings.py.

# development | production
APTUS_ENV=development

# Required in production, minimum 32 characters.
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
APTUS_SECRET_KEY=

# Required in production. SQLite is rejected there: row-level tenant
# isolation needs PostgreSQL.
APTUS_DATABASE_URL=postgresql+psycopg://aptus:aptus@localhost:5432/aptus

# Comma-separated. Required in production; '*' is rejected.
APTUS_ALLOWED_ORIGINS=http://localhost:5173

# Optional
APTUS_SESSION_TTL_HOURS=12
APTUS_VERIFICATION_TTL_HOURS=48
APTUS_FREE_TIER_SEAT_CAP=2
APTUS_FREE_TIER_MAY_FORK_REFERENCES=true
